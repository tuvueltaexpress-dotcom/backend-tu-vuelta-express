# Copiar a .env y completar los valores. El .env no se versiona.

# PostgreSQL — los usa docker-compose.yml para levantar la base local
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Puerto que expone el contenedor en el host (default 5433)
POSTGRES_PORT=5433

# Backend
PORT=3000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=
# Debe apuntar al mismo host/puerto/credenciales de arriba
# postgresql://USER:PASSWORD@localhost:5433/DB?schema=public
DATABASE_URL=

JWT_SECRET_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox — token propio del backend para la Directions API (costo de envío).
# Debe ir SIN restricción de URL: Mapbox la valida contra el header Referer,
# que las peticiones desde el servidor no envían.
MAPBOX_TOKEN=

# Admin inicial que planta `npm run seed` (opcionales, estos son los valores por defecto).
# El login del panel se hace con ADMIN_SEED_USERNAME, no con el email.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@admin.com
ADMIN_SEED_PASSWORD=Admin123*

# Partner de prueba que planta `npm run seed:dev` (opcionales, estos son los
# valores por defecto). Ese seed es solo para desarrollo: aborta si
# NODE_ENV=production salvo que se pase SEED_DEV_FORCE=1.
SEED_DEV_PARTNER_EMAIL=partner@demo.com
SEED_DEV_PARTNER_PASSWORD=Partner123
